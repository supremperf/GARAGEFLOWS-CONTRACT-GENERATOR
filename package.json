{
  "name": "garageflows-contract-generator",
  "version": "1.0.1",
  "description": "GarageFlows Contract Generator — Logiciel professionnel autonome de génération automatique de contrats d'abonnement GarageFlows",
  "author": "GarageFlows",
  "license": "UNLICENSED",
  "private": true,
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build:renderer": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build:examples": "tsx scripts/generate-examples.ts",
    "build": "npm run verify:config && npm run build:branding && npm run build:examples && npm run build:renderer && npm run build:electron",
    "dist": "npm run build && node scripts/prepare-dist.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "lint": "eslint .",
    "build:branding": "node scripts/generate-icon.mjs",
    "verify:dist": "node scripts/verify-branding.mjs",
    "test:ui": "playwright test",
    "verify:config": "node scripts/verify-config.mjs",
    "test:runtime": "node scripts/test-compiled-runtime.cjs",
    "test:installed": "node scripts/test-windows-installer.mjs"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "jszip": "^3.10.1",
    "lucide-react": "^0.468.0",
    "mammoth": "^1.8.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.2.67",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sql.js": "^1.12.0",
    "tesseract.js": "^5.1.1"
  },
  "devDependencies": {
    "@assistant-ai/electron-win32-x64": "28.3.3",
    "@electron/asar": "^3.4.1",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "7zip-bin": "5.2.0",
    "electron": "npm:@assistant-ai/electron-win32-x64@28.3.3",
    "electron-builder": "26.15.3",
    "eslint": "^9.39.5",
    "js-yaml": "^4.3.2",
    "resedit": "^3.1.0",
    "semver": "^7.7.3",
    "sharp": "^0.35.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.72.0",
    "vite": "^6.0.5",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "mammoth": {
      "argparse": "^2.0.1"
    },
    "app-builder-lib": {
      "@electron/get": {
        "global-agent": "^4.1.3",
        ".": "^4.0.3"
      }
    },
    "canvas": "^3.2.3"
  },
  "optionalDependencies": {
    "@esbuild/win32-x64": "0.25.12",
    "@rollup/rollup-win32-x64-msvc": "4.65.0"
  },
  "engines": {
    "node": ">=22.12.0 <23",
    "npm": ">=10"
  }
}
